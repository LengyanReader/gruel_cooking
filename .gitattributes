# Normalize line endings: text files are LF in the index and on checkout.
# This is a text-first repo (md/py/yml/json/html); LF is safe for all of them
# and stops the per-commit CRLF warning churn. Exceptions below.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf

# Binary assets — never touch.
*.ogg -text
*.mp3 -text
*.wav -text
*.png -text
*.jpg -text
*.jpeg -text
*.gif -text
*.ico -text
*.db -text
*.pdf -text
*.zip -text
*.ttf -text
*.woff -text
*.woff2 -text
