<!DOCTYPE html>
<html lang="zh">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>语言叠织 · Language Stacking — 一意而万语 | 舟洲粥</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=LXGW+WenKai:wght@300;400;700&family=Inter:wght@300;400;500;600;700&family=Noto+Serif+JP:wght@300;400;600&family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=Noto+Serif+Devanagari:wght@300;400;600&display=swap" rel="stylesheet">
<style>
:root {
  --ls-night: #1B2433; --ls-night-2: #232F46; --ls-night-3: #2D3B57;
  --ls-moon: #F2D9A0; --ls-moon-soft: #E8C07A; --ls-moon-dim: #C9A465;
  --ls-fog: #9FB4C8; --ls-fog-soft: #CBD6E2;
  --ls-paper: #FBF7EF; --ls-paper-soft: #F5EEDF;
  --ink-deep: #2A2620; --ink-mid: #5C5248; --ink-soft: #8A7E72; --ink-pale: #B8AFA4;
  --accent-teal: #5BA3A3;
  --ff-display: "LXGW WenKai", "Noto Serif SC", serif;
  --ff-body: "Inter", "LXGW WenKai", "Noto Sans SC", sans-serif;
  --ff-garamond: "EB Garamond", "Inter", serif;
  --shadow-md: 0 6px 20px rgba(27,36,51,0.10);
  --shadow-lg: 0 12px 40px rgba(27,36,51,0.14);
}

/* ── Bilingual toggle ── */
body.lang-zh [data-en] { display: none !important; }
body.lang-en [data-zh] { display: none !important; }
body.lang-en [data-both] span[data-en] { display: inline !important; }
body.lang-en [data-both] span[data-zh] { display: none !important; }
body.lang-zh [data-both] span[data-zh] { display: inline !important; }
body.lang-zh [data-both] span[data-en] { display: none !important; }

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; -webkit-font-smoothing: antialiased; }
body {
  font-family: var(--ff-body); color: var(--ink-deep); background: var(--ls-paper);
  line-height: 1.8; overflow-x: hidden;
}
a { color: var(--accent-teal); text-decoration: none; transition: color 0.25s; }
a:hover { color: #3E8FA8; }
.lang-note-script { font-family: var(--ff-garamond); }

/* ═══ NAV ═══ */
.nav {
  position: fixed; top: 0; left: 0; right: 0; z-index: 100;
  padding: 0.6rem 2rem; display: flex; align-items: center; justify-content: space-between;
  background: rgba(27,36,51,0.72); backdrop-filter: blur(20px) saturate(1.3);
  -webkit-backdrop-filter: blur(20px) saturate(1.3);
  border-bottom: 1px solid rgba(159,180,200,0.18); transition: all 0.3s;
}
.nav.scrolled { background: rgba(22,29,42,0.94); box-shadow: 0 2px 16px rgba(0,0,0,0.2); }
.nav-brand { font-family: var(--ff-display); font-weight: 700; font-size: 1.25rem; color: var(--ls-moon); letter-spacing: 0.05em; }
.nav-brand .sub { font-size: 0.65em; color: var(--ls-fog); margin-left: 0.5em; font-weight: 400; letter-spacing: 0.12em; }
.nav-right { display: flex; align-items: center; gap: 1.5rem; }
.nav-links { display: flex; gap: 1.8rem; list-style: none; }
.nav-links a { color: var(--ls-fog-soft); font-size: 0.875rem; font-weight: 500; letter-spacing: 0.04em; position: relative; }
.nav-links a:hover { color: var(--ls-moon); }
.nav-home { color: var(--ls-fog-soft); font-size: 0.8rem; font-weight: 500; border: 1px solid rgba(159,180,200,0.35); border-radius: 18px; padding: 4px 14px; }
.nav-home:hover { color: var(--ls-moon); border-color: var(--ls-moon-dim); }
.lang-toggle { display: flex; border-radius: 20px; overflow: hidden; border: 1px solid rgba(159,180,200,0.35); font-size: 0.8rem; font-weight: 500; cursor: pointer; }
.lang-toggle button { border: none; padding: 5px 14px; cursor: pointer; font-family: var(--ff-body); font-size: 0.8rem; font-weight: 500; transition: all 0.25s; color: var(--ls-fog-soft); background: transparent; }
.lang-toggle button.active { background: linear-gradient(135deg, var(--ls-moon-soft), var(--ls-moon)); color: #3A2E18; }
.lang-toggle button:hover:not(.active) { color: var(--ls-moon); }

/* ═══ HERO ═══ */
.hero {
  position: relative; min-height: 100vh; display: flex; flex-direction: column;
  align-items: center; justify-content: center; text-align: center; padding: 5rem 2rem; overflow: hidden;
  background:
    radial-gradient(900px 460px at 78% 16%, rgba(242,217,160,0.20), transparent 60%),
    radial-gradient(340px 340px at 78% 26%, rgba(242,217,160,0.5), transparent 70%),
    linear-gradient(172deg, #10171F 0%, #1B2433 26%, #26344F 55%, #3A4A66 78%, #F6EEDA 92%, var(--ls-paper) 100%);
  color: #EAF0F6;
}
.hero-moon {
  position: absolute; width: 190px; height: 190px; border-radius: 50%;
  top: 14%; right: 14%;
  background: radial-gradient(circle at 38% 34%, #FFF6DC 0%, var(--ls-moon) 42%, var(--ls-moon-soft) 78%, #D9B87E 100%);
  box-shadow: 0 0 90px rgba(242,217,160,0.55), 0 0 30px rgba(242,217,160,0.35);
  opacity: 0.92; pointer-events: none;
}
.hero-moon::before {
  content: ""; position: absolute; inset: 8%;
  background: radial-gradient(circle at 40% 30%, transparent 30%, rgba(120,98,60,0.18) 55%, rgba(120,98,60,0.10) 78%);
  border-radius: 50%;
}
.hero-stars { position: absolute; inset: 0; pointer-events: none; }
.hero-stars i {
  position: absolute; width: 2px; height: 2px; border-radius: 50%;
  background: #DDE7F2; opacity: 0.5; animation: twinkle 4s ease-in-out infinite;
}
.hero-stars i:nth-child(odd) { animation-delay: 1.2s; }
@keyframes twinkle { 0%,100% { opacity: 0.18; } 50% { opacity: 0.75; } }
.hero-content { position: relative; z-index: 2; max-width: 880px; }
.hero-kicker { font-size: 0.9rem; letter-spacing: 0.35em; color: var(--ls-moon-dim); margin-bottom: 1rem; font-weight: 500; }
.hero h1 { font-family: var(--ff-display); font-size: clamp(2.6rem, 7vw, 4.6rem); font-weight: 700; color: #F5EFE2; letter-spacing: 0.06em; line-height: 1.25; margin-bottom: 0.6rem; }
.hero h1 .moon-char { color: var(--ls-moon); }
.hero .subtitle { font-family: var(--ff-display); font-size: clamp(1.05rem, 2.4vw, 1.5rem); color: #D8E2EE; font-weight: 300; letter-spacing: 0.14em; margin-bottom: 1.5rem; }
.hero .languages {
  display: flex; flex-wrap: wrap; gap: 0.5rem 0.9rem; justify-content: center; margin: 0 auto 2rem; max-width: 640px;
}
.hero .languages span {
  font-size: 0.95rem; color: #C9D6E4; border: 1px solid rgba(201,214,228,0.28);
  border-radius: 99px; padding: 5px 14px; background: rgba(27,36,51,0.35);
}
.hero .languages span sv { display: inline-block; margin-right: 6px; opacity: 0.9; }
.hero .tagline { font-family: var(--ff-display); font-size: 1.1rem; color: var(--ls-moon-soft); letter-spacing: 0.08em; margin-bottom: 0.5rem; }
.hero .tagline-en { font-family: var(--ff-garamond); font-style: italic; font-size: 1.05rem; color: #9FB4C8; max-width: 620px; margin: 0 auto 2rem; }
.hero .scroll-hint {
  position: absolute; bottom: 2.2rem; left: 50%; transform: translateX(-50%);
  display: flex; flex-direction: column; align-items: center; gap: 6px;
  color: var(--ls-fog); font-size: 0.75rem; letter-spacing: 0.12em; animation: bob 3s ease-in-out infinite;
}
.scroll-line { width: 1px; height: 30px; background: linear-gradient(to bottom, var(--ls-fog), transparent); }
@keyframes bob { 0%,100% { transform: translateX(-50%) translateY(0); } 50% { transform: translateX(-50%) translateY(6px); } }

/* ═══ SECTIONS ═══ */
.section { padding: 5rem 2rem; max-width: 1200px; margin: 0 auto; }
.section-header { text-align: center; margin-bottom: 3rem; }
.section-header h2 { font-family: var(--ff-display); font-size: clamp(1.8rem, 4vw, 2.4rem); font-weight: 700; color: var(--ink-deep); letter-spacing: 0.03em; }
.section-header.dark h2 { color: #EDF2F8; }
.section-header .subtitle { font-size: 1rem; color: var(--ink-soft); font-weight: 300; letter-spacing: 0.1em; }
.section-header.dark .subtitle { color: var(--ls-fog); }
.section-header .divider { display: block; width: 56px; height: 2px; background: linear-gradient(90deg, transparent, var(--ls-moon-dim), transparent); margin: 0.9rem auto; border-radius: 1px; }

.band-dark { background: linear-gradient(180deg, #1B2433 0%, #232F46 100%); color: #DCE4EE; }
.band-paper { background: var(--ls-paper); }
.band-soft { background: var(--ls-paper-soft); }

/* ═══ DNA PILLARS ═══ */
.dna-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; }
.dna-card {
  background: rgba(255,255,255,0.06); border: 1px solid rgba(242,217,160,0.22);
  border-radius: 18px; padding: 2rem 1.8rem; position: relative; overflow: hidden;
  transition: transform 0.3s ease, border-color 0.3s ease;
}
.dna-card:hover { transform: translateY(-5px); border-color: var(--ls-moon); }
.dna-card .big { font-family: var(--ff-display); font-size: 2.6rem; color: var(--ls-moon); display: block; margin-bottom: 0.4rem; line-height: 1; }
.dna-card h3 { font-family: var(--ff-display); font-size: 1.35rem; color: #F5EFE2; margin-bottom: 0.3rem; }
.dna-card .roman { font-family: var(--ff-garamond); color: var(--ls-fog); font-size: 0.85rem; letter-spacing: 0.16em; text-transform: uppercase; margin-bottom: 0.8rem; display: block; }
.dna-card p { color: #C4D0DE; font-size: 0.95rem; }
.rules { margin-top: 2rem; display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 0.9rem; }
.rule { display: flex; gap: 0.8rem; background: rgba(255,255,255,0.05); border-radius: 12px; padding: 0.9rem 1rem; border: 1px solid rgba(159,180,200,0.18); }
.rule .n { flex-shrink: 0; width: 26px; height: 26px; border-radius: 50%; background: linear-gradient(135deg, var(--ls-moon), var(--ls-moon-soft)); color: #3A2E18; font-weight: 700; font-size: 0.75rem; display: flex; align-items: center; justify-content: center; }
.rule h5 { font-family: var(--ff-display); font-size: 0.95rem; color: var(--ls-moon); margin-bottom: 2px; }
.rule p { font-size: 0.82rem; color: #C4D0DE; }

/* ═══ LANGUAGE CARDS ═══ */
.lang-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.4rem; }
.lang-card {
  --lsc: #C9A465; --lsbg: rgba(27,36,51,0.05);
  background: var(--ls-paper); border-radius: 18px; border: 1px solid rgba(201,164,101,0.35);
  padding: 1.6rem 1.6rem 1.4rem; box-shadow: var(--shadow-md);
  position: relative; overflow: hidden; transition: transform 0.3s ease, box-shadow 0.3s ease;
}
.lang-card::before { content: ""; position: absolute; top: 0; left: 0; right: 0; height: 4px; background: linear-gradient(90deg, var(--lsc), var(--lsc)); opacity: 0.85; }
.lang-card:hover { transform: translateY(-5px); box-shadow: var(--shadow-lg); }
.lang-card .glyph { font-family: var(--ff-display); font-size: 1.7rem; color: var(--ink-deep); line-height: 1.3; display: block; margin-bottom: 0.2rem; }
.lang-card .ly2 { font-family: "Noto Serif JP", var(--ff-display), serif; }
.lang-card .lsa { font-family: "Noto Serif Devanagari", serif; }
.lang-card .lu { font-family: var(--ff-garamond), serif; }
.lang-card .name { font-size: 0.9rem; font-weight: 600; color: var(--ink-deep); letter-spacing: 0.02em; }
.lang-card .iso { color: var(--ink-pale); font-size: 0.78rem; font-weight: 500; margin-left: 6px; }
.lang-card .family { font-size: 0.8rem; color: var(--ink-soft); margin: 0.35rem 0 0.6rem; letter-spacing: 0.04em; }
.lang-card .dna {
  font-family: var(--ff-display); font-size: 1.02rem; color: var(--ink-deep);
  border-top: 1px dashed rgba(201,164,101,0.4); padding-top: 0.6rem; line-height: 1.6; margin-bottom: 0.4rem;
}
.lang-card .dna .label { font-size: 0.7rem; color: var(--ink-pale); letter-spacing: 0.16em; display: block; margin-bottom: 2px; }
.lang-card .kw { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 0.7rem; }
.lang-card .kw span { font-size: 0.72rem; padding: 2px 10px; border-radius: 99px; background: var(--lsbg); color: var(--ink-mid); border: 1px solid rgba(27,36,51,0.08); }
.lang-card .role { font-size: 0.85rem; color: var(--ink-soft); font-style: italic; }

/* ═══ THEME CARDS ═══ */
.theme-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 1.2rem; }
.theme-card {
  background: var(--ls-paper); border-radius: 16px; padding: 1.5rem 1.4rem;
  border: 1px solid rgba(201,164,101,0.3); box-shadow: var(--shadow-md);
  transition: transform 0.3s ease, box-shadow 0.3s ease; text-align: center;
}
.theme-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
.theme-card .mark { font-size: 1.8rem; display: block; margin-bottom: 0.4rem; }
.theme-card h4 { font-family: var(--ff-display); font-size: 1.25rem; color: var(--ink-deep); }
.theme-card .en-name { font-family: var(--ff-garamond); font-style: italic; color: var(--ink-pale); font-size: 0.85rem; margin-bottom: 0.4rem; display: block; }
.theme-card p { font-size: 0.85rem; color: var(--ink-soft); }

/* ═══ FORMAT CARDS ═══ */
.fmt-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.2rem; }
.fmt-card { background: rgba(255,255,255,0.06); border: 1px solid rgba(159,180,200,0.22); border-radius: 16px; padding: 1.5rem 1.5rem; transition: border-color 0.3s, transform 0.3s; }
.fmt-card:hover { border-color: var(--ls-moon); transform: translateY(-4px); }
.fmt-card .code { display: inline-block; font-family: var(--ff-garamond); font-size: 0.78rem; letter-spacing: 0.14em; color: var(--ls-moon); border: 1px solid var(--ls-moon-dim); border-radius: 6px; padding: 2px 10px; margin-bottom: 0.7rem; }
.fmt-card h4 { font-family: var(--ff-display); font-size: 1.1rem; color: #F0F4F9; margin-bottom: 0.2rem; }
.fmt-card .en-tag { font-family: var(--ff-garamond); font-style: italic; color: var(--ls-fog); font-size: 0.8rem; }
.fmt-card p { color: #C4D0DE; font-size: 0.88rem; margin-top: 0.4rem; }

.band-dark .pillar-hint { text-align: center; color: var(--ls-fog); font-size: 0.9rem; margin-top: 2rem; }
.band-dark .pillar-hint a { color: var(--ls-moon); }

/* ═══ SAMPLE STACK ═══ */
.stack-wrap { overflow-x: auto; border-radius: 16px; box-shadow: var(--shadow-md); }
.stack-table { border-collapse: collapse; width: 100%; min-width: 720px; font-size: 0.95rem; background: var(--ls-paper); }
.stack-table th { background: #232F46; color: var(--ls-moon); font-weight: 600; text-align: left; padding: 0.9rem 1.1rem; font-size: 0.85rem; letter-spacing: 0.08em; }
.stack-table td { padding: 0.95rem 1.1rem; border-top: 1px solid rgba(201,164,101,0.25); vertical-align: top; }
.stack-table td.l { font-weight: 600; white-space: nowrap; color: var(--ink-deep); }
.stack-table .orig { font-size: 0.8rem; color: var(--ink-pale); }
.stack-table .si18n { font-family: var(--ff-display); font-size: 1.12rem; color: var(--ink-deep); line-height: 1.7; }
.stack-table .smode { font-family: var(--ff-garamond); font-size: 0.78rem; color: var(--ink-pale); margin-left: 8px; }
.stack-table .gloss { font-size: 0.82rem; color: var(--ink-soft); margin-top: 0.2rem; }
.teach-note { margin-top: 1.2rem; padding: 1rem 1.2rem; border-left: 3px solid var(--ls-moon-dim); background: var(--ls-paper-soft); border-radius: 0 12px 12px 0; font-size: 0.92rem; color: var(--ink-mid); }

/* ═══ GLOSSARY ═══ */
.gloss-wrap { overflow-x: auto; border-radius: 16px; box-shadow: var(--shadow-md); }
.gloss-table { border-collapse: collapse; width: 100%; min-width: 760px; font-size: 0.9rem; background: var(--ls-paper); }
.gloss-table th { background: #232F46; color: var(--ls-moon); text-align: left; padding: 0.75rem 1rem; font-size: 0.8rem; letter-spacing: 0.05em; }
.gloss-table .co { background: #F5EEDF; }
.gloss-table td { padding: 0.7rem 1rem; border-top: 1px solid rgba(201,164,101,0.22); white-space: nowrap; }
.gloss-table td.concept { font-weight: 600; color: var(--ink-deep); background: #F5EEDF; white-space: normal; }
.gloss-table .gsa { font-family: "Noto Serif Devanagari", serif; }
.gloss-table .gja { font-family: "Noto Serif JP", serif; }

/* ═══ ROADMAP ═══ */
.road { display: flex; flex-direction: column; gap: 1rem; max-width: 900px; margin: 0 auto; }
.road-item { display: flex; gap: 1.2rem; align-items: flex-start; background: var(--ls-paper); border-radius: 14px; padding: 1.2rem 1.4rem; border: 1px solid rgba(201,164,101,0.28); box-shadow: var(--shadow-md); }
.road-item .dot { flex-shrink: 0; width: 34px; height: 34px; border-radius: 50%; background: linear-gradient(135deg, #232F46, #3A4A66); color: var(--ls-moon); display: flex; align-items: center; justify-content: center; font-family: var(--ff-garamond); font-weight: 600; }
.road-item h4 { font-family: var(--ff-display); font-size: 1.05rem; color: var(--ink-deep); }
.road-item .when { font-size: 0.78rem; color: var(--ls-moon-dim); font-weight: 600; }
.road-item p { font-size: 0.88rem; color: var(--ink-soft); }

/* ═══ PILOT CARDS ═══ */
.pilot-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.1rem; }
.pilot-card { background: rgba(255,255,255,0.06); border: 1px solid rgba(242,217,160,0.2); border-radius: 14px; padding: 1.3rem 1.3rem; }
.pilot-card .typ { display: inline-block; font-family: var(--ff-garamond); font-size: 0.75rem; letter-spacing: 0.1em; color: var(--ls-moon); border: 1px solid var(--ls-moon-dim); border-radius: 6px; padding: 1px 9px; margin-bottom: 0.6rem; }
.pilot-card h5 { font-family: var(--ff-display); font-size: 1rem; color: #F0F4F9; margin-bottom: 0.2rem; }
.pilot-card .why { font-size: 0.8rem; color: var(--ls-fog); }
.pilot-card p { font-size: 0.85rem; color: #C4D0DE; }

/* ═══ FOOTER ═══ */
.footer { text-align: center; padding: 3rem 2rem 2rem; color: var(--ls-fog); font-size: 0.875rem; border-top: 1px solid rgba(159,180,200,0.2); background: #1B2433; }
.footer .motto { font-family: var(--ff-display); font-size: 1.125rem; color: var(--ls-moon); font-weight: 300; letter-spacing: 0.12em; margin-bottom: 0.3rem; }
.footer a { color: var(--ls-fog-soft); }
.footer a:hover { color: var(--ls-moon); }

/* ═══ EXPANSION ROSTER ═══ */
.exp-groups { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.2rem; }
.exp-card { background: var(--ls-paper); border: 1px solid rgba(201,164,101,0.3); border-radius: 16px; padding: 1.2rem 1.3rem; box-shadow: var(--shadow-md); }
.exp-head { display: flex; align-items: baseline; justify-content: space-between; gap: 0.6rem; border-bottom: 1px dashed rgba(201,164,101,0.4); padding-bottom: 0.5rem; margin-bottom: 0.7rem; }
.exp-name { font-family: var(--ff-display); font-size: 1.15rem; font-weight: 700; color: var(--ink-deep); }
.exp-en { font-family: var(--ff-garamond); font-style: italic; color: var(--ink-pale); font-size: 0.8rem; }
.exp-chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }
.chip { display: inline-flex; align-items: center; gap: 6px; background: var(--ls-paper-soft); border: 1px solid rgba(27,36,51,0.1); border-radius: 10px; padding: 4px 10px; font-size: 0.85rem; color: var(--ink-deep); }
.chip b { font-weight: 600; }
.chip i { font-style: normal; font-size: 0.72rem; color: var(--ink-soft); }
.chip em { font-style: normal; font-weight: 700; font-size: 0.66rem; width: 18px; height: 18px; line-height: 18px; text-align: center; border-radius: 50%; color: #fff; flex-shrink: 0; }
.chip em.a { background: #3E8FB0; }
.chip em.b { background: #C9A465; }
.exp-legend { margin-top: 1.2rem; text-align: center; font-size: 0.85rem; color: var(--ink-soft); }
.hero .ext-note { font-size: 0.78rem; color: var(--ls-fog); letter-spacing: 0.14em; margin: -1.2rem 0 2rem; }

/* ═══ GOJŪON ═══ */
.goji-intro { max-width: 780px; margin: 0 auto 2rem; text-align: center; color: var(--ink-soft); font-size: 0.95rem; }
.kana-wrap { overflow-x: auto; border-radius: 16px; box-shadow: var(--shadow-md); }
.kana-table { border-collapse: collapse; width: 100%; min-width: 560px; background: var(--ls-paper); }
.kana-table th { background: #232F46; color: var(--ls-moon); padding: 0.6rem 0.4rem; font-size: 0.8rem; font-weight: 600; letter-spacing: 0.06em; }
.kana-table th.vowel { font-family: var(--ff-garamond); }
.kana-table td { text-align: center; padding: 0.55rem 0.3rem; border: 1px solid rgba(201,164,101,0.22); }
.kana-table td.rowname { font-family: var(--ff-display); font-weight: 700; color: var(--ink-deep); background: #F5EEDF; white-space: nowrap; font-size: 0.95rem; width: 84px; }
.kana-cell .k { font-family: "Noto Sans JP", "Inter", sans-serif; font-size: 0.92rem; color: var(--ink-soft); display: block; margin-bottom: 2px; letter-spacing: 0.08em; }
.kana-cell .h { font-family: "Noto Serif JP", var(--ff-display), serif; font-size: 1.75rem; color: var(--ink-deep); display: block; line-height: 1.25; }
.kana-cell .r { font-family: var(--ff-garamond); font-size: 0.8rem; color: var(--ls-moon-dim); letter-spacing: 0.04em; }
.kana-cell.particle { background: #FFF3DD; }
.kana-cell.void { background: rgba(27,36,51,0.03); }
.kana-cell.void span { color: var(--ink-pale); font-family: var(--ff-garamond); font-size: 0.8rem; }
.derived { margin-top: 1.2rem; display: flex; flex-wrap: wrap; gap: 0.55rem; justify-content: center; }
.derived span { font-family: "Noto Serif JP", var(--ff-display), serif; background: var(--ls-paper); border: 1px solid rgba(201,164,101,0.35); border-radius: 99px; padding: 4px 14px; font-size: 0.92rem; color: var(--ink-deep); line-height: 1.6; }
.derived .dl { font-family: var(--ff-garamond); font-size: 0.7rem; letter-spacing: 0.12em; color: var(--ls-moon-dim); margin-right: 6px; font-style: normal; }
.kana-word { min-width: 900px; }
.kana-word tbody td { white-space: normal; vertical-align: top; }
.kana-word .kc { text-align: center; vertical-align: middle; white-space: nowrap; }
.kana-word .kc .big { font-family: "Noto Serif JP", var(--ff-display), serif; font-size: 1.35rem; color: var(--ink-deep); display: block; line-height: 1.3; }
.kana-word .kc .kana-kat { font-family: "Noto Sans JP", sans-serif; font-size: 0.72rem; color: var(--ink-pale); display: block; }
.kana-word .kw2 { font-family: var(--ff-display); font-size: 1.02rem; color: var(--ink-deep); }
.kana-word .furigana { font-size: 0.8rem; color: var(--ink-soft); font-weight: 400; }
.kana-word .rom { font-family: var(--ff-garamond); color: var(--ls-moon-dim); font-size: 0.82rem; font-style: italic; }
.kana-word .sent { font-family: "Noto Serif JP", var(--ff-display), serif; font-size: 0.98rem; color: var(--ink-deep); line-height: 1.7; }
.kana-word .tr { font-size: 0.8rem; color: var(--ink-soft); margin-top: 2px; }

/* ═══ RESPONSIVE ═══ */
@media (max-width: 768px) {
  .nav-links { display: none; }
  .nav { padding: 0.6rem 1rem; }
  .hero { min-height: 90vh; padding-top: 4rem; }
  .hero-moon { width: 130px; height: 130px; top: 12%; right: 6%; }
  .section { padding: 3rem 1.1rem; }
  .lang-grid { grid-template-columns: 1fr; }
  .theme-grid { grid-template-columns: 1fr 1fr; }
  .dna-grid, .fmt-grid { grid-template-columns: 1fr; }
}
</style>
</head>
