<!-- ═══ HERO ═══ -->
<section class="hero">
  <div class="hero-moon"></div>
  <div class="hero-stars"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
  <div class="hero-content">
    <div class="hero-kicker" data-both>
      <span data-zh>舟洲粥 · 第六域</span><span data-en>Zhōu Zhōu Zhōu · The Sixth Domain</span>
    </div>
    <h1 data-both>
      <span data-zh><span class="moon-char">一意</span>而万语</span>
      <span data-en>One <span class="moon-char">Meaning</span>, a Thousand Tongues</span>
    </h1>
    <div class="subtitle" data-both>
      <span data-zh>同一心象，八面语法之镜；一镜而八澜。</span>
      <span data-en>One image of thought, eight mirrors of grammar; one mirror, eight ripples.</span>
    </div>
    <div class="languages">
      <span><svg width="8" height="8" viewBox="0 0 8 8"><circle cx="4" cy="4" r="3" fill="#E8C07A"/></svg>中文</span>
      <span><svg width="8" height="8" viewBox="0 0 8 8"><circle cx="4" cy="4" r="3" fill="#E8C07A"/></svg>English</span>
      <span><svg width="8" height="8" viewBox="0 0 8 8"><circle cx="4" cy="4" r="3" fill="#E8C07A"/></svg>Français</span>
      <span><svg width="8" height="8" viewBox="0 0 8 8"><circle cx="4" cy="4" r="3" fill="#E8C07A"/></svg>日本語</span>
      <span><svg width="8" height="8" viewBox="0 0 8 8"><circle cx="4" cy="4" r="3" fill="#E8C07A"/></svg>संस्कृतम्</span>
      <span><svg width="8" height="8" viewBox="0 0 8 8"><circle cx="4" cy="4" r="3" fill="#E8C07A"/></svg>Latina</span>
      <span><svg width="8" height="8" viewBox="0 0 8 8"><circle cx="4" cy="4" r="3" fill="#E8C07A"/></svg>Deutsch</span>
      <span><svg width="8" height="8" viewBox="0 0 8 8"><circle cx="4" cy="4" r="3" fill="#E8C07A"/></svg>Svenska</span>
    </div>
    <div class="ext-note">
      <span data-zh>核心八语 —— 编队已扩至六大洲 32 语 · 各文明代表语种详见下文矩阵 ↓</span>
      <span data-en>Core eight — the roster now spans 6 continents × 32 tongues · every civilization sends its representative ↓</span>
    </div>
    <div class="tagline">叠 · 织 · 照</div>
    <div class="tagline-en">Stack, Weave, Illuminate — each language keeps its own civilizational soul.</div>
  </div>
