        <tr><td class="rowname">ら行</td>
          <td class="kana-cell"><span class="k">ラ</span><span class="h">ら</span><span class="r">ra</span></td>
          <td class="kana-cell"><span class="k">リ</span><span class="h">り</span><span class="r">ri</span></td>
          <td class="kana-cell"><span class="k">ル</span><span class="h">る</span><span class="r">ru</span></td>
          <td class="kana-cell"><span class="k">レ</span><span class="h">れ</span><span class="r">re</span></td>
          <td class="kana-cell"><span class="k">ロ</span><span class="h">ろ</span><span class="r">ro</span></td></tr>
        <tr><td class="rowname">わ行</td>
          <td class="kana-cell"><span class="k">ワ</span><span class="h">わ</span><span class="r">wa</span></td>
