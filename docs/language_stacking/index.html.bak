          <td class="kana-cell"><span class="k">ク</span><span class="h">く</span><span class="r">ku</span></td>
          <td class="kana-cell"><span class="k">ケ</span><span class="h">け</span><span class="r">ke</span></td>
          <td class="kana-cell"><span class="k">コ</span><span class="h">こ</span><span class="r">ko</span></td></tr>
        <tr><td class="rowname">さ行</td>
          <td class="kana-cell"><span class="k">サ</span><span class="h">さ</span><span class="r">sa</span></td>
          <td class="kana-cell"><span class="k">シ</span><span class="h">し</span><span class="r">shi</span></td>
          <td class="kana-cell"><span class="k">ス</span><span class="h">す</span><span class="r">su</span></td>
          <td class="kana-cell"><span class="k">セ</span><span class="h">せ</span><span class="r">se</span></td>
          <td class="kana-cell"><span class="k">ソ</span><span class="h">そ</span><span class="r">so</span></td></tr>
        <tr><td class="rowname">た行</td>
          <td class="kana-cell"><span class="k">タ</span><span class="h">た</span><span class="r">ta</span></td>
          <td class="kana-cell"><span class="k">チ</span><span class="h">ち</span><span class="r">chi</span></td>
          <td class="kana-cell"><span class="k">ツ</span><span class="h">つ</span><span class="r">tsu</span></td>
          <td class="kana-cell"><span class="k">テ</span><span class="h">て</span><span class="r">te</span></td>
          <td class="kana-cell"><span class="k">ト</span><span class="h">と</span><span class="r">to</span></td></tr>
        <tr><td class="rowname">な行</td>
          <td class="kana-cell"><span class="k">ナ</span><span class="h">な</span><span class="r">na</span></td>
