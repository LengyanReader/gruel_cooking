{
  "_note": "RKF L2 lens for kind=history — declarative slot thresholds consumed by engine/extract_driver.py and audit.py. Each layer names an output slot in the book record + a min bar. Thresholds live here, not in code; ratchet them up as corpus coverage proves capacity (evolution S6). Maps to framework.md 五维无损 for a scholarly history volume.",
  "kind": "history",
  "corpus_required": true,
  "layers": [
    { "slot": "background",            "target": "background.zh",                     "min_chars": 120, "weight": "required", "guarantee": "content" },
    { "slot": "skeleton",              "target": "plot_acts",                         "min_items": 3,  "weight": "required", "guarantee": "structure" },
    { "slot": "brief.main",            "target": "plot_acts[].brief.main",            "per_item_min_chars": 40, "weight": "required", "guarantee": "content" },
    { "slot": "brief.flow",            "target": "plot_acts[].brief.flow",            "per_item_min_chars": 60, "weight": "required", "guarantee": "depth" },
    { "slot": "brief.names",           "target": "plot_acts[].brief.names",           "per_item_min_chars": 30, "weight": "required", "guarantee": "content" },
    { "slot": "brief.sources",         "target": "plot_acts[].brief.sources",         "per_item_min_chars": 20, "weight": "required", "guarantee": "evidence" },
    { "slot": "brief.link",            "target": "plot_acts[].brief.link",            "per_item_min_chars": 20, "weight": "required", "guarantee": "structure" },
    { "slot": "intent.quotes",         "target": "intent.quotes",                     "min_items": 2,  "weight": "required", "guarantee": "evidence", "ip": "short-quotes-only" },
    { "slot": "characters",            "target": "characters",                        "min_items": 5,  "weight": "required", "guarantee": "content" },
    { "slot": "craft",                 "target": "craft",                             "min_items": 5,  "weight": "required", "guarantee": "depth" },
    { "slot": "read_through",          "target": "read_through.observations",         "min_items": 3,  "weight": "required", "guarantee": "depth" },
    { "slot": "full_analysis",         "target": "full_analysis.zh",                  "min_chars": 300,"weight": "required", "guarantee": "depth" },
    { "slot": "disagreements",         "target": "intent.reception_bad_zh",           "min_chars": 40, "weight": "required", "guarantee": "evidence" }
  ],
  "grounding": {
    "rule": "a history book is COMPLETE only if every required slot clears its bar AND a corpus file exists for its id AND n_plot_acts <= n_corpus_docs",
    "audit_mode": "--corpus"
  }
}
